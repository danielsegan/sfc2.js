{
  "name": "sfc2.js",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Clean-room browser engine for Star Trek: Starfleet Command 2",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test:formats": "node --experimental-strip-types --test tools/formats/*.test.ts",
    "test:ship-audit": "node --experimental-strip-types --test tools/ship-audit/*.test.ts",
    "test:engine": "vitest run",
    "ship-audit": "node --experimental-strip-types tools/ship-audit/cli.ts",
    "duel:metrics": "node --experimental-strip-types tools/duel-metrics/cli.ts",
    "viewer-check": "node --experimental-strip-types tools/viewer-check/cli.ts",
    "test": "pnpm test:formats && pnpm test:ship-audit && pnpm test:engine",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:sim": "node tools/check-sim-syntax.mjs && node tools/check-sim-home.mjs && eslint .",
    "lut:check": "node tools/generate-angle-lut.mjs --check",
    "replay:check": "node --experimental-strip-types engine/replay/cli.ts check replays",
    "replay:record": "node --experimental-strip-types engine/replay/cli.ts record replays",
    "replay:browsers": "playwright test",
    "dev:viewer": "vite --config web/ship-viewer/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts --host 127.0.0.1 --port 1701 --strictPort",
    "build:web": "vite build --config web/vite.config.ts",
    "tutorial": "node tools/tutorial/run.mjs",
    "tutorial:v2": "node tools/tutorial/run.mjs --lesson v2",
    "tutorial:v3": "node tools/tutorial/run.mjs --lesson v3",
    "desktop:dev": "pnpm exec tauri dev",
    "desktop:build": "pnpm exec tauri build",
    "check": "pnpm typecheck && pnpm lint:sim && pnpm lut:check && pnpm test && pnpm replay:check && node tools/check-rules-fixtures.mjs && bash tools/check-no-game-files.sh"
  },
  "dependencies": {
    "@sfc2js/formats": "workspace:*",
    "@sfc2js/platform": "workspace:*",
    "@sfc2js/render": "workspace:*",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.19.1",
    "@types/three": "^0.181.0",
    "eslint": "^9.16.0",
    "fast-check": "^3.23.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.3.8",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
